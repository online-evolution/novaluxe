# Kopieer naar .env.local en vul in. Nooit echte waarden committen.

# Neon Postgres, pooled verbinding (de host bevat "-pooler"): voor de applicatie
DATABASE_URL=

# Neon Postgres, directe verbinding (zonder "-pooler"): voor migraties
DATABASE_URL_UNPOOLED=

# Geheim voor HMAC van rate-limit-sleutels (willekeurig, minimaal 32 tekens)
AUTH_SECRET=

# Optioneel: vaste basis-URL voor links naar klanten (bijv. https://www.novaluxe.nl).
# Leeg = voor vrijgavelinks het adres waarop het beheer draait; in mails het
# productieadres van Vercel.
SITE_URL=
